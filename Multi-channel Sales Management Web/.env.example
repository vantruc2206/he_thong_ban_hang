# =========================================================================
# OMNISELL - CẤU HÌNH MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# Sao chép file này sang file .env và điền các giá trị thực tế
# =========================================================================

# 1. SUPABASE DATABASE & AUTH (Cần thiết để chạy App)
# Lấy các giá trị này tại: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. SHOPEE OPEN PLATFORM (Lấy tại open.shopee.com)
VITE_SHOPEE_PARTNER_ID=1234567
VITE_SHOPEE_PARTNER_KEY=your_shopee_partner_key_here
VITE_SHOPEE_REDIRECT_URL=https://your-domain.com/auth/shopee

# 3. LAZADA OPEN PLATFORM (Lấy tại open.lazada.com)
VITE_LAZADA_APP_KEY=123456
VITE_LAZADA_APP_SECRET=your_lazada_app_secret_here
VITE_LAZADA_REDIRECT_URL=https://your-domain.com/auth/lazada

# 4. TIKTOK SHOP PARTNER (Lấy tại partner.tiktokshop.com)
VITE_TIKTOK_APP_KEY=your_tiktok_app_key_here
VITE_TIKTOK_APP_SECRET=your_tiktok_app_secret_here

# 5. ĐƠN VỊ VẬN CHUYỂN (Tùy chọn)
VITE_GHN_TOKEN=your_ghn_api_token
VITE_GHTK_TOKEN=your_ghtk_api_token

# 6. CONFIG KHÁC
VITE_APP_NAME="LANA beauty Pro - Quản lý Bán hàng đa kênh"
VITE_DEFAULT_PAGE_SIZE=20
