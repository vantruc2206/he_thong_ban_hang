# Sample Configuration for Google & Facebook OAuth 2.0
# Copy file này thành .env và điền các giá trị Client ID thực tế từ Developer Consoles:

# 1. Google Client ID (Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs):
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 2. Facebook App ID (Meta for Developers -> Apps -> Basic Settings -> App ID):
VITE_FACEBOOK_APP_ID=your-facebook-app-id
